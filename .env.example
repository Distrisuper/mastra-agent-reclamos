# =================================================================
# VARIABLES DE ENTORNO - DISTRIBUIDORA RECLAMOS AGENT
# =================================================================
# Copia este archivo a .env y completa los valores reales.
# Nunca commits .env con valores reales de API keys.
# =================================================================

# -----------------------------------------------------------------
# OPENROUTER - Proveedor de Modelos de IA
# -----------------------------------------------------------------
# API key de OpenRouter para acceso a múltiples modelos de IA
# Obtener en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-tu-api-key-aqui

# Modelo a usar por defecto (formato: openrouter/proveedor/modelo)
# El workflow n8n usa google/gemini-2.5-flash via OpenRouter
OPENROUTER_MODEL=openrouter/google/gemini-2.5-flash

# -----------------------------------------------------------------
# POSTGRESQL - Base de datos de reclamos
# -----------------------------------------------------------------
# URL de conexión a PostgreSQL donde se insertan los reclamos
# Schema: reclamos (tablas: reclamos, reclamos_eventos, canales, areas, sistemas, estados)
POSTGRES_URL=postgresql://user:pass@host:5432/reclamos

# -----------------------------------------------------------------
# MASTRA - Configuración del Framework
# -----------------------------------------------------------------
# Nivel de logging (debug, info, warn, error)
LOG_LEVEL=info

# Entorno (development, production)
NODE_ENV=development

# Puerto del servidor Mastra (por defecto: 4111)
MASTRA_PORT=4111

# Host del servidor Mastra
MASTRA_HOST=localhost

# Shared secret for custom ingest endpoint (optional but recommended)
INGEST_API_SECRET=replace-with-a-shared-secret

# -----------------------------------------------------------------
# N8N - Webhooks
# -----------------------------------------------------------------
# URL del webhook n8n "Endpoint guardar reclamo"
N8N_GUARDAR_RECLAMO_URL=http://distrimdp.dvrdns.org:5678/webhook/guardar-reclamo

# URL del webhook n8n "Reclamos recientes" (para detección de duplicados)
N8N_RECLAMOS_RECIENTES_URL=http://distrimdp.dvrdns.org:5678/webhook/reclamos-recientes

# -----------------------------------------------------------------
# BASE DE DATOS - LibSQL/SQLite
# -----------------------------------------------------------------
# URL de conexión a la base de datos
# Para desarrollo: archivo local
# Para producción: URL completa (file:/path/to/db.sqlite o libsql://host)
DATABASE_URL=file:./reclamos.db

# -----------------------------------------------------------------
# OBSERVABILIDAD - Tracing y Telemetría
# -----------------------------------------------------------------
# Mastra Studio almacena trazas en la base LibSQL (DATABASE_URL).
# Para enviar trazas a Mastra Cloud, descomenta y completa:
# MASTRA_CLOUD_ACCESS_TOKEN=tu-token-aqui

# Para integraciones externas (opcional, descomentar según plataforma):
# --- Langfuse ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- OpenTelemetry genérico (Datadog, New Relic, SigNoz, etc.) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer tu-token

# =================================================================
# NOTAS DE SEGURIDAD
# =================================================================
# 1. NUNCA commits .env con valores reales al repositorio
# 2. Usa .env.example como plantilla
# 3. Rota las API keys periódicamente
# 4. Usa variables de entorno en producción, no archivos .env
# =================================================================
